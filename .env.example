# Copy to .env (gitignored) and fill in. Never commit .env.

# ---- Model router (see docs/06-model-router.md) ----
# Which ladder config to load from config/router.*.yaml
BRAIN_ROUTER_PROFILE=dev          # dev | replay | prod

# ---- Google AI Studio (free tier; see ADR-0002) ----
GOOGLE_AI_API_KEY=

# ---- Optional alternate providers (T2 ladder rungs) ----
GROQ_API_KEY=
OPENROUTER_API_KEY=

# ---- Local ML service (T1) ----
ML_SERVICE_URL=http://localhost:8081

# ---- Eval ----
# record = call live APIs and save cassettes; replay = offline, deterministic, free
BRAIN_CASSETTE_MODE=replay        # replay | record | live
BRAIN_EVAL_DATASET=datasets/v1
